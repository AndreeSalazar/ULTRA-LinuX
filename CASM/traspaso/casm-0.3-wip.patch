+    return 1;
+}
+static const char *op_name(int k) {
+    switch (k) { case OP_TICS: return "tics"; case OP_CONST: return "const"; case OP_LOAD: return "load"; case OP_STORE: return "store";
+                 case OP_TORCX: return "torcx"; case OP_ADD: return "add"; case OP_SUB: return "sub"; case OP_MUL: return "mul";
+                 case OP_PUTS: return "puts"; case OP_PRINT: return "print"; default: return "?"; }
