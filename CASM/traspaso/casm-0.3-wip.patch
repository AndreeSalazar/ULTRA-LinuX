new file mode 100644
index 0000000..ed87a79
--- /dev/null
+++ b/CASM/examples/tics.casm
@@ -0,0 +1,11 @@
+// CASM 0.3: the first runtime value. metal_tics() reads the CPU time-stamp counter (rdtsc).
+void metal_main(void) {
+    const char texto[] = "tics: ";
+    const char salto[] = "\r\n";
+    const uint64_t t = metal_tics();
+    const uint64_t siguiente = t + 1;
+    metal_puts(texto);
+    metal_put_int(siguiente);
+    metal_puts(salto);
+    return;
+}
diff --git a/CASM/src/casm.h b/CASM/src/casm.h
index d34ed9b..2871aee 100644
--- a/CASM/src/casm.h
+++ b/CASM/src/casm.h
@@ -36,13 +36,36 @@ typedef struct {
     unsigned rpn_tokens;
     int used;
     long decimal;        /* constant index of its decimal rendering, or -1 */
+    int runtime;         /* value known only at run time (reads metal_tics) */
+    int slot;            /* frame slot for a runtime integer, else -1 */
 } CasmInteger;
 typedef struct { size_t constant; unsigned line; } CasmCall;
+
+/* CASM 0.3 runtime: a program that reads metal_tics() (rdtsc) runs real x86-64.
+ * The body is an ordered op stream; both the emitter and the independent verifier
+ * turn it into the same bytes. A checked op that can overflow emits a trap block. */
+#define CASM_OPS_MAX 1024
+enum {
+    OP_TICS,   /* rdtsc -> rax (edx:eax combined) */
+    OP_CONST,  /* mov rax, imm (imm holds the value) */
+    OP_LOAD,   /* mov rax, [frame + slot] */
+    OP_TORCX,  /* mov rcx, rax (keep the left operand) */
+    OP_ADD, OP_SUB, OP_MUL,  /* rax = rax (op) rcx, then jc -> trap (trap = katana index) */
+    OP_STORE,  /* mov [frame + slot], rax */
+    OP_PUTS,   /* lea rsi,[rip+data]; call [r15+16]  (slot = constant index) */
+    OP_PRINT   /* load slot, print rax as unsigned decimal through puts */
+};
+typedef struct { int kind; unsigned line; uint64_t imm; int slot; int trap; } CasmOp;
+typedef struct { unsigned code_offset, length, line; } CasmTrap; /* where a katana cuts */
+
 typedef struct {
     CasmConstant constants[CASM_ITEMS_MAX];
     CasmCall calls[CASM_ITEMS_MAX];
     CasmInteger integers[CASM_ITEMS_MAX];
-    size_t constant_count, call_count, integer_count;
+    CasmOp ops[CASM_OPS_MAX];
+    CasmTrap traps[CASM_ITEMS_MAX];
+    size_t constant_count, call_count, integer_count, op_count, trap_count;
+    size_t runtime_count;          /* integers computed by the CPU, not the compiler */
     unsigned return_line;
 } CasmProgram;
 
