+/* ---------- CASM 0.3: runtime integers ----------
+ * A declaration whose value comes from metal_tics() (rdtsc) runs on the CPU. The compiler
+ * cannot know the value, so it emits x86-64 that computes it with the SAME checked rules,
+ * and every operation that can overflow emits a trap block. Scope in 0.3: uint64_t only,
+ * one operation per expression, operands are metal_tics(), a runtime integer, another
+ * uint64 value, or a literal. */
+static int add_op(Parser *p, CasmProgram *program, int kind, unsigned line, uint64_t imm, int slot, int trap) {
+    CasmOp *o;
+    if (program->op_count >= CASM_OPS_MAX) return fail(p, "OPS-LIMIT", "Too many runtime operations.");
+    o = &program->ops[program->op_count++];
+    o->kind = kind; o->line = line; o->imm = imm; o->slot = slot; o->trap = trap;
+    return 1;
