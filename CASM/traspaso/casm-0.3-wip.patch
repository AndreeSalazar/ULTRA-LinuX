+/* ---------- CASM 0.3: runtime code ----------
+ * Frame: push r13; sub rsp,F; mov r13,rsp. r13 is the frame base (buffer at [r13+0..23],
+ * runtime slot i at [r13+24+8i]); RBP, R15 and the stack are preserved for the bridge.
+ * F keeps rsp 16-aligned at each call to puts. Every instruction has a fixed length, so
+ * the layout is computed first and then written. */
+#define BUF_END 23u
+static unsigned frame_bytes(size_t slots) { unsigned f = (unsigned)(24 + 8 * slots); f = (f + 15u) & ~15u; return f + 8u; }
+static unsigned slot_disp(int slot) { return 24u + 8u * (unsigned)slot; }
+static size_t op_length(const CasmOp *o) {
+    switch (o->kind) {
+    case OP_TICS: return 9; case OP_CONST: return 10; case OP_LOAD: case OP_STORE: return 7;
+    case OP_TORCX: return 3; case OP_ADD: case OP_SUB: case OP_MUL: return 9;
+    case OP_PUTS: return 11; case OP_PRINT: return 47; default: return 0;
+    }
+}
+static size_t imm_rsp_length(unsigned f) { return f <= 127 ? 4 : 7; }
+static size_t put_imm_rsp(unsigned char *b, unsigned char op_ext, unsigned f) {
+    /* sub rsp,F (/5 -> EC) or add rsp,F (/0 -> C4) */
+    if (f <= 127) { b[0]=0x48; b[1]=0x83; b[2]=op_ext; b[3]=(unsigned char)f; return 4; }
+    b[0]=0x48; b[1]=0x81; b[2]=op_ext; put32(b+3,f); return 7;
+}
+static int emit_runtime(const CasmProgram *program, unsigned char *body, size_t *size_out, size_t *offsets,
+                        CasmTrap *traps, size_t *trap_count, unsigned *frame_out) {
+    unsigned f = frame_bytes(program->runtime_count);
+    size_t at, i, code, trap_off, data, n_traps = 0;
+    int any_trap = 0;
+    code = 2 + imm_rsp_length(f) + 3;
+    for (i = 0; i < program->op_count; i++) { code += op_length(&program->ops[i]); if (program->ops[i].trap) any_trap = 1; }
+    code += imm_rsp_length(f) + 2 + 1;
+    trap_off = code;
+    data = code + (any_trap ? 3 : 0);
+    for (i = 0; i < program->constant_count; i++) {
+        if (program->constants[i].length > CASM_BODY_MAX || data > CASM_BODY_MAX - program->constants[i].length) {
+            fprintf(stderr,"RED [BODY-LIMIT] Code and data exceed 4072 bytes.\n"); return 0;
+        }
+        offsets[i] = data; data += program->constants[i].length;
+    }
+    memset(body, 0, CASM_BODY_MAX);
+    at = 0;
+    body[at++]=0x41; body[at++]=0x55;                       /* push r13 */
+    at += put_imm_rsp(body+at, 0xEC, f);                    /* sub rsp,F */
+    body[at++]=0x49; body[at++]=0x89; body[at++]=0xE5;      /* mov r13,rsp */
+    for (i = 0; i < program->op_count; i++) {
+        const CasmOp *o = &program->ops[i];
+        size_t start = at;
+        switch (o->kind) {
+        case OP_TICS:  /* rdtsc; shl rdx,32; or rax,rdx */
+            memcpy(body+at,"\x0f\x31\x48\xc1\xe2\x20\x48\x09\xd0",9); at+=9; break;
+        case OP_CONST: { size_t k; body[at++]=0x48; body[at++]=0xB8; for (k=0;k<8;k++) body[at++]=(unsigned char)(o->imm>>(8*k)); break; }
+        case OP_LOAD:  body[at++]=0x49; body[at++]=0x8B; body[at++]=0x85; put32(body+at,slot_disp(o->slot)); at+=4; break;
+        case OP_STORE: body[at++]=0x49; body[at++]=0x89; body[at++]=0x85; put32(body+at,slot_disp(o->slot)); at+=4; break;
+        case OP_TORCX: memcpy(body+at,"\x48\x89\xc1",3); at+=3; break;
+        case OP_ADD: case OP_SUB: case OP_MUL:
+            if (o->kind==OP_ADD) memcpy(body+at,"\x48\x01\xc8",3);
+            else if (o->kind==OP_SUB) memcpy(body+at,"\x48\x29\xc8",3);
+            else memcpy(body+at,"\x48\xf7\xe1",3);
