[
  {
    "name": "hud",
    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 4,
    "modules-left": [
      "custom/apps",
      "hyprland/workspaces",
      "hyprland/window"
    ],
    "modules-center": [
      "clock"
    ],
    "modules-right": [
      "custom/equipo",
      "cpu",
      "memory",
      "network",
      "pulseaudio",
      "custom/autor",
      "custom/ambiente",
      "custom/logout"
    ],
    "custom/apps": {
      "format": "  BMO-X",
      "tooltip-format": "Centro BMO-X · Super+Space",
      "on-click": "ultra-super menu"
    },
    "hyprland/workspaces": {
      "format": "{icon}",
      "format-icons": {
        "1": "01",
        "2": "02",
        "3": "03",
        "4": "04",
        "5": "05",
        "6": "06",
        "7": "07",
        "8": "08",
        "9": "09"
      },
      "all-outputs": false,
      "persistent-workspaces": {
        "*": [
          1,
          2,
          3,
          4,
          5
        ]
      },
      "on-click": "activate"
    },
    "hyprland/window": {
      "format": "{title}",
      "max-length": 40,
      "separate-outputs": true
    },
    "clock": {
      "format": "{:%H:%M}",
      "format-alt": "{:%a %d %b · LIMA}",
      "timezone": "America/Lima",
      "locale": "es_PE.UTF-8",
      "on-click-right": "foot --hold ultra-hora",
      "tooltip-format": "<big>{:%A %d de %B}</big>\n<tt>{calendar}</tt>"
    },
    "cpu": {
      "format": "<span color='#00f0ff' size='small'>CPU</span> {usage}%",
      "states": {
        "alerta": 80
      },
      "interval": 3,
      "tooltip": true,
      "tooltip-format": "CPU {usage}% · carga {load} · {avg_frequency} GHz\nClic: lo que mas consume y cerrarlo o frenarlo\nClic derecho: administrador ordenado por CPU",
      "on-click": "ultra-aplicaciones rapido cpu",
      "on-click-right": "foot --fullscreen --title='ULTRA / Aplicaciones' ultra-aplicaciones --orden cpu"
    },
    "memory": {
      "format": "<span color='#00f0ff' size='small'>RAM</span> {used:0.1f}G",
      "interval": 5,
      "tooltip-format": "RAM: {used:0.2f} / {total:0.2f} GiB · {percentage}%\nClic: lo que mas memoria usa y cerrarlo o limitarlo\nClic derecho: administrador ordenado por RAM",
      "on-click": "ultra-aplicaciones rapido ram",
      "on-click-right": "foot --fullscreen --title='ULTRA / Aplicaciones' ultra-aplicaciones --orden ram"
    },
    "network": {
      "format-ethernet": "<span color='#00f0ff' size='small'>NET</span> {ifname}",
      "format-linked": "<span color='#00f0ff' size='small'>NET</span> SIN IP",
      "format-disconnected": "<span color='#ff2a4f' size='small'>NET</span> SIN ENLACE",
      "tooltip-format": "{ifname} · {ipaddr}/{cidr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}\nEnlace local; acceso a Internet sin comprobar",
      "interval": 3
    },
    "custom/ambiente": {
      "format": "",
      "tooltip-format": "Alternar efectos · Super+Shift+A",
      "on-click": "ultra-ambiente alternar",
      "on-click-right": "ultra-personalizar menu"
    },
    "custom/autor": {
      "format": "EDDI",
      "tooltip-format": "Eddi Salazar · autor de ULTRA LinuX / BMO-X",
      "on-click": "foot --hold /usr/bin/cat /etc/ultra/AUTOR.txt"
    },
    "custom/logout": {
      "format": "",
      "tooltip-format": "Volver a la consola",
      "on-click": "hyprctl dispatch 'hl.dsp.exit()'"
    },
    "pulseaudio": {
      "format": "<span color='#00f0ff' size='small'>VOL</span> {volume}%",
      "format-muted": "<span color='#ff2a4f' size='small'>VOL</span> MUTE",
      "format-source": "{volume}%",
      "on-click": "ultra-audio menu",
      "on-click-right": "pavucontrol",
      "on-scroll-up": "ultra-audio subir",
      "on-scroll-down": "ultra-audio bajar",
      "tooltip-format": "Audio maestro: {desc}\nClick: control · derecho: salidas y aplicaciones"
    },
    "custom/equipo": {
      "exec": "ultra-equipo barra",
      "return-type": "json",
      "interval": 10,
      "on-click": "foot --title='ULTRA / Equipo en vivo' watch -n 2 ultra-equipo texto",
      "tooltip": true
    }
  },
  {
    "name": "dock",
    "layer": "top",
    "position": "bottom",
    "height": 56,
    "width": 580,
    "margin-bottom": 12,
    "spacing": 4,
    "exclusive": true,
    "modules-center": [
      "custom/super",
      "custom/browser",
      "custom/games",
      "custom/files",
      "custom/terminal",
      "custom/editor",
      "custom/capture",
      "custom/help"
    ],
    "custom/browser": {
      "format": "",
      "tooltip-format": "Brave · Super+B",
      "on-click": "ultra-brave"
    },
    "custom/files": {
      "format": "",
      "tooltip-format": "Archivos · Super+E",
      "on-click": "thunar"
    },
    "custom/terminal": {
      "format": "",
      "tooltip-format": "Terminal · Super+Enter",
      "on-click": "foot"
    },
    "custom/editor": {
      "format": "",
      "tooltip-format": "Editor · Super+N",
      "on-click": "mousepad"
    },
    "custom/help": {
      "format": "",
      "tooltip-format": "Ayuda · Super+H",
      "on-click": "foot /usr/bin/less /etc/ultra/AYUDA.txt"
    },
    "custom/games": {
      "format": "",
      "tooltip-format": "Juegos · Super+J",
      "on-click": "ultra-juegos menu"
    },
    "custom/super": {
      "format": "",
      "tooltip-format": "SUPER · Super+Espacio\nDerecho: atajos · Super+F1",
      "on-click": "ultra-super menu",
      "on-click-right": "ultra-super atajos"
    },
    "custom/capture": {
      "format": "",
      "tooltip-format": "Capturar · Super+S\nRegion: Super+Shift+S",
      "on-click": "ultra-super captura",
      "on-click-right": "ultra-captura abrir"
    }
  }
]
