[
  {
    "name": "hud",
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 10,
    "margin-left": 14,
    "margin-right": 14,
    "spacing": 4,
    "modules-left": [
      "custom/apps",
      "hyprland/workspaces",
      "hyprland/window"
    ],
    "modules-center": [
      "clock"
    ],
    "modules-right": [
      "custom/equipo",
      "cpu",
      "memory",
      "network",
      "pulseaudio",
      "custom/ambiente",
      "custom/logout"
    ],
    "custom/apps": {
      "format": "  BMO-X",
      "tooltip-format": "Centro BMO-X · Super+Space",
      "on-click": "ultra-ambiente menu"
    },
    "hyprland/workspaces": {
      "format": "{name}",
      "all-outputs": false,
      "persistent-workspaces": {
        "*": [
          1,
          2,
          3,
          4
        ]
      },
      "on-click": "activate"
    },
    "hyprland/window": {
      "format": "{title}",
      "max-length": 18,
      "separate-outputs": true
    },
    "clock": {
      "format": "{:%H:%M}",
      "format-alt": "{:%a %d / %m}",
      "timezone": "America/Lima",
      "locale": "es_PE.UTF-8",
      "on-click-right": "foot --hold ultra-hora",
      "tooltip-format": "<big>{:%A %d de %B}</big>\n<tt>{calendar}</tt>"
    },
    "cpu": {
      "format": " {usage}%",
      "interval": 3,
      "tooltip": true
    },
    "memory": {
      "format": " {used:0.1f}G",
      "interval": 5,
      "tooltip-format": "RAM: {used:0.2f} / {total:0.2f} GiB · {percentage}%"
    },
    "network": {
      "format-ethernet": " {ifname}",
      "format-linked": " SIN IP",
      "format-disconnected": " SIN ENLACE",
      "tooltip-format": "{ifname} · {ipaddr}/{cidr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}\nEnlace local; acceso a Internet sin comprobar",
      "interval": 3
    },
    "custom/ambiente": {
      "format": "",
      "tooltip-format": "Alternar efectos · Super+Shift+A",
      "on-click": "ultra-ambiente alternar",
      "on-click-right": "ultra-ambiente menu"
    },
    "custom/logout": {
      "format": "",
      "tooltip-format": "Volver a la consola",
      "on-click": "hyprctl dispatch 'hl.dsp.exit()'"
    },
    "pulseaudio": {
      "format": " {volume}%",
      "format-muted": " MUTE",
      "format-source": " {volume}%",
      "on-click": "ultra-audio menu",
      "on-click-right": "pavucontrol",
      "on-scroll-up": "ultra-audio subir",
      "on-scroll-down": "ultra-audio bajar",
      "tooltip-format": "Audio maestro: {desc}\nClick: control · derecho: salidas y aplicaciones"
    },
    "custom/equipo": {
      "exec": "ultra-equipo barra",
      "return-type": "json",
      "interval": 10,
      "on-click": "foot --title='ULTRA / Equipo en vivo' watch -n 2 ultra-equipo texto",
      "tooltip": true
    }
  },
  {
    "name": "dock",
    "layer": "top",
    "position": "bottom",
    "height": 56,
    "width": 420,
    "margin-bottom": 12,
    "spacing": 4,
    "exclusive": true,
    "modules-center": [
      "custom/browser",
      "custom/games",
      "custom/files",
      "custom/terminal",
      "custom/editor",
      "custom/help"
    ],
    "custom/browser": {
      "format": "",
      "tooltip-format": "Brave · Super+B",
      "on-click": "ultra-brave"
    },
    "custom/files": {
      "format": "",
      "tooltip-format": "Archivos · Super+E",
      "on-click": "thunar"
    },
    "custom/terminal": {
      "format": "",
      "tooltip-format": "Terminal · Super+Enter",
      "on-click": "foot"
    },
    "custom/editor": {
      "format": "",
      "tooltip-format": "Editor · Super+N",
      "on-click": "mousepad"
    },
    "custom/help": {
      "format": "",
      "tooltip-format": "Ayuda · Super+H",
      "on-click": "foot /usr/bin/less /etc/ultra/AYUDA.txt"
    },
    "custom/games": {
      "format": "",
      "tooltip-format": "Juegos · Super+J",
      "on-click": "ultra-juegos menu"
    }
  }
]
