#!/usr/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
# One bounded, read-only snapshot. No device opens, tuning or privileged tools.
set -uo pipefail
mode=snapshot
if [[ $# == 1 && $1 == --inventario ]]; then mode=inventario
elif [[ $# != 0 ]]; then exit 2; fi
shopt -s nullglob
printf 'ULTRA RECURSOS v1 solo_lectura=1 contadores=acumulados\n'
emit() {
    local group=$1 key=$2 path=$3 value=
    if [[ -r $path ]] && { IFS= read -r value < "$path" 2>/dev/null || [[ -n $value ]]; }; then
        printf '%s %s=%s\n' "$group" "$key" "$value"
    else
        printf '%s %s=NA\n' "$group" "$key"
    fi
}
if [[ $mode == inventario ]]; then
    printf 'INVENTARIO RECURSOS v1 deteccion_actual=1 ajustes_automaticos=0\n'
    emit EQUIPO kernel /proc/sys/kernel/osrelease
    # Only the first logical CPU; no serials, hostnames or firmware UUIDs.
    if [[ -r /proc/cpuinfo ]]; then
        while IFS=: read -r key value; do
            [[ -n $key ]] || break
            key=${key//[$' \t']/}
            case "$key" in
                vendor_id|modelname|cpufamily|model|stepping|siblings|cpucores)
                    printf 'IDENTIDAD_CPU %s=%s\n' "$key" "$value";;
            esac
        done < /proc/cpuinfo
    else printf 'IDENTIDAD_CPU NA\n'; fi
    emit TOPOLOGIA cpu_online /sys/devices/system/cpu/online
    emit TOPOLOGIA numa_online /sys/devices/system/node/online
    caches=0
    for cache in /sys/devices/system/cpu/cpu0/cache/index*; do
        [[ -d $cache ]] || continue
        ((caches < 8)) || break
        ((caches+=1))
        for key in level type size coherency_line_size shared_cpu_list; do
            emit "CACHE indice=${cache##*/}" "$key" "$cache/$key"
        done
    done
    printf 'CACHE indices_mostrados=%s limite=8 cpu_referencia=0\n' "$caches"
    printf 'CAPACIDAD ram_tipo_fisico=NA\n'
    printf 'CAPACIDAD ram_tipo_nota=no_inferir_DDR_ECC_o_canales_desde_meminfo\n'
    emit CAPACIDAD psi_cpu /proc/pressure/cpu
    emit CAPACIDAD psi_memoria /proc/pressure/memory
    emit CAPACIDAD psi_io /proc/pressure/io
    # Fall through to the bounded snapshot: contains RAM size and block devices.
fi
emit RELOJ uptime_idle_s /proc/uptime
emit CPU loadavg /proc/loadavg
for resource in cpu memory io; do
    file=/proc/pressure/$resource
    if [[ -r $file ]]; then
        lines=0
        while IFS= read -r row; do
            printf 'PSI recurso=%s %s\n' "$resource" "$row"
            ((lines+=1)); ((lines < 2)) || break
        done < "$file" 2>/dev/null
        ((lines > 0)) || printf 'PSI recurso=%s NA\n' "$resource"
    else printf 'PSI recurso=%s NA\n' "$resource"; fi
done
# Fixed-path, unprivileged C reader. Failure is unavailable, never zero.
if ! /usr/local/libexec/ultra-recursos-contadores; then
    printf 'MEM NA\nVM NA\n'
fi
for key in swappiness dirty_background_bytes dirty_bytes dirty_background_ratio dirty_ratio; do
    emit POLITICA "$key" "/proc/sys/vm/$key"
done
emit POLITICA thp /sys/kernel/mm/transparent_hugepage/enabled
emit POLITICA thp_defrag /sys/kernel/mm/transparent_hugepage/defrag
emit POLITICA zswap /sys/module/zswap/parameters/enabled
policies=0
for policy in /sys/devices/system/cpu/cpufreq/policy*; do
    [[ -d $policy ]] || continue
    ((policies < 16)) || break
    ((policies+=1))
    for key in scaling_driver scaling_governor energy_performance_preference scaling_cur_freq scaling_min_freq scaling_max_freq; do
        emit "CPU politica=${policy##*/}" "$key" "$policy/$key"
    done
done
printf 'CPU politicas_mostradas=%s limite=16 frecuencia_unidad=kHz puede_ser_solicitada\n' "$policies"
disks=0
for disk in /sys/block/*; do
    [[ -d $disk ]] || continue
    ((disks < 32)) || break
    ((disks+=1))
    if [[ $mode == inventario ]]; then
        for key in vendor model; do
            emit "IDENTIDAD_BLOQUE dispositivo=${disk##*/}" "$key" "$disk/device/$key"
        done
        emit "IDENTIDAD_BLOQUE dispositivo=${disk##*/}" sectores_512 "$disk/size"
        emit "IDENTIDAD_BLOQUE dispositivo=${disk##*/}" solo_lectura "$disk/ro"
        case ${disk##*/} in
            nvme*) family=nvme;; loop*) family=loop;; zram*) family=zram;; dm-*) family=device_mapper;; *) family=otro;;
        esac
        printf 'IDENTIDAD_BLOQUE dispositivo=%s familia_nombre=%s tipo_fisico_no_inferido=1\n' "${disk##*/}" "$family"
        links=0
        for slave in "$disk"/slaves/*; do
            ((links < 16)) || break
            ((links+=1))
            printf 'CAPA dispositivo=%s inferior=%s\n' "${disk##*/}" "${slave##*/}"
        done
        printf 'CAPA dispositivo=%s inferiores_mostrados=%s limite=16\n' "${disk##*/}" "$links"
    fi
    for key in rotational scheduler read_ahead_kb logical_block_size physical_block_size discard_max_bytes; do
        emit "BLOQUE dispositivo=${disk##*/}" "$key" "$disk/queue/$key"
    done
    emit "BLOQUE dispositivo=${disk##*/}" stat "$disk/stat"
    case ${disk##*/} in
        zram*) for key in mm_stat io_stat; do emit "ZRAM dispositivo=${disk##*/}" "$key" "$disk/$key"; done;;
    esac
done
printf 'BLOQUE dispositivos_mostrados=%s limite=32 no_sumar_capas=1\n' "$disks"
printf 'fin_recursos snapshot_no_atomico=1 faltante_no_es_cero=1\n'
