#!/usr/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
set -euo pipefail
[[ $(id -u) == 1000 ]] || exit 1
action=${1:-menu}
if [[ $action == menu ]]; then
    choice=$(printf '%s\n' 'Subir volumen' 'Bajar volumen' 'Silencio' 'Volumen 100%' 'Amplificar 125%' 'Amplificar 150%' 'Salidas y volumen por aplicacion' |
        fuzzel --dmenu --prompt='Audio maestro /' --lines=7) || exit 0
    case $choice in
        'Subir volumen') action=subir;; 'Bajar volumen') action=bajar;; Silencio) action=silencio;;
        'Volumen 100%') action=normal;; 'Amplificar 125%') action=boost125;; 'Amplificar 150%') action=boost150;;
        'Salidas y volumen por aplicacion') exec pavucontrol;; *) exit 0;;
    esac
fi
case $action in
    subir) wpctl set-volume --limit 1.5 @DEFAULT_AUDIO_SINK@ 5%+;;
    bajar) wpctl set-volume --limit 1.5 @DEFAULT_AUDIO_SINK@ 5%-;;
    silencio) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle;;
    normal) wpctl set-volume --limit 1.5 @DEFAULT_AUDIO_SINK@ 100%;;
    boost125) wpctl set-volume --limit 1.5 @DEFAULT_AUDIO_SINK@ 125%;;
    boost150) wpctl set-volume --limit 1.5 @DEFAULT_AUDIO_SINK@ 150%;;
    estado) exec wpctl status;;
    *) exit 2;;
esac
volume=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
notify-send --app-name=ULTRA --icon=audio-volume-high 'Audio maestro' "$volume" || true
