#!/usr/bin/python3
# SPDX-License-Identifier: GPL-2.0-only
"""ULTRA Sonido: graves, ecualizador y 3D para todo el escritorio (UID 1000).

    ultra-sonido preparar          escribe el filtro de PipeWire con lo guardado (antes de pipewire)
    ultra-sonido panel             abre o cierra el panel (Super+A o Super+Ctrl+A)
    ultra-sonido estado            JSON para el panel
    ultra-sonido escuchar          JSON en cada cambio (deflisten de eww)
    ultra-sonido poner CLAVE VAL   cambia un control en vivo y lo guarda
    ultra-sonido perfil NOMBRE     plano, musica, juegos, peliculas, voz, graves, auriculares, fuerte
    ultra-sonido alternar          activa o deja el sonido original (sin borrar ajustes)
    ultra-sonido volumen N         volumen del dispositivo, 0-150 %

WirePlumber enruta la reproducción de la salida por defecto por el filtro.
El realce de intensidad usa un limitador estéreo después del ecualizador.
"""
import fcntl
import json
import math
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time

HOME = Path(os.environ.get('HOME', '/home/ultra'))
STATE = HOME/'.config/ultra/sonido.json'
PW_CONF = HOME/'.config/pipewire/pipewire.conf.d/ultra-sonido.conf'
EWW_DIR = HOME/'.cache/ultra/sonido-eww'
EWW_SRC = Path('/etc/ultra')
NODE = 'ultra_sonido'
LIMITER = Path('/usr/lib/ladspa/fast_lookahead_limiter_1913.so')
LOUDNESS_DB = 9.0

# clave: (minimo, maximo, defecto)
RANGES = {
    'graves': (-6.0, 12.0, 0.0), 'cuerpo': (-12.0, 12.0, 0.0), 'medios': (-12.0, 12.0, 0.0),
    'presencia': (-12.0, 12.0, 0.0), 'agudos': (-12.0, 12.0, 0.0),
    'amplitud': (0.0, 100.0, 0.0), 'auriculares': (0.0, 100.0, 0.0),
    'intensidad': (0.0, 12.0, 0.0),
}
BANDS = [  # nombre, filtro, frecuencia, Q
    ('graves', 'bq_lowshelf', 90.0, 0.7), ('cuerpo', 'bq_peaking', 250.0, 1.0),
    ('medios', 'bq_peaking', 1000.0, 1.0), ('presencia', 'bq_peaking', 3500.0, 1.0),
    ('agudos', 'bq_highshelf', 9000.0, 0.7),
]
PROFILES = {
    'plano':     dict(graves=0, cuerpo=0, medios=0, presencia=0, agudos=0, amplitud=0, auriculares=0),
    'musica':    dict(graves=5, cuerpo=1, medios=-1, presencia=2, agudos=3, amplitud=35, auriculares=0),
    'juegos':    dict(graves=4, cuerpo=-2, medios=0, presencia=4, agudos=2, amplitud=55, auriculares=0),
    'peliculas': dict(graves=6, cuerpo=0, medios=1, presencia=2, agudos=1, amplitud=60, auriculares=0),
    'voz':       dict(graves=-3, cuerpo=-1, medios=3, presencia=4, agudos=0, amplitud=0, auriculares=0),
    'graves':    dict(graves=10, cuerpo=2, medios=-1, presencia=0, agudos=1, amplitud=20, auriculares=0),
    'auriculares': dict(graves=3, cuerpo=0, medios=0, presencia=2, agudos=1, amplitud=20, auriculares=60),
    'fuerte':    dict(graves=3, cuerpo=0, medios=1, presencia=3, agudos=1, amplitud=0, auriculares=0, intensidad=LOUDNESS_DB),
}
for profile in PROFILES.values():
    profile.setdefault('intensidad', 0.0)
CROSSFEED_DELAY = 0.0003   # 0.3 ms: diferencia entre oidos
CROSSFEED_CUTOFF = 700.0   # la cabeza tapa los agudos del lado opuesto


def default_state():
    return dict({k: v[2] for k, v in RANGES.items()}, activo=True, perfil='plano')


def clamp(key, value):
    low, high, _ = RANGES[key]
    value = float(value)
    if not math.isfinite(value): raise ValueError(f'valor no valido para {key}')
    return round(min(high, max(low, value)), 1)


def load():
    state = default_state()
    try:
        if STATE.is_file() and not STATE.is_symlink() and STATE.stat().st_size <= 4096:
            doc = json.loads(STATE.read_text())
            if isinstance(doc, dict):
                for key in RANGES:
                    if isinstance(doc.get(key), (int, float)): state[key] = clamp(key, doc[key])
                if isinstance(doc.get('activo'), bool): state['activo'] = doc['activo']
                if doc.get('perfil') in PROFILES or doc.get('perfil') == 'personal': state['perfil'] = doc['perfil']
    except (OSError, ValueError): pass
    return state


def atomic(path, text, mode=0o600):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix='.sonido-', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as output:
            os.fchmod(output.fileno(), mode)
            output.write(text); output.flush(); os.fsync(output.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary): os.unlink(temporary)


def save(state):
    atomic(STATE, json.dumps(state, sort_keys=True)+'\n')


# ---------- valores del grafo ----------
def controls(state, limiter=False):
    """Todos los controles del grafo para un estado (en bypass todo neutro)."""
    on = state['activo']
    gains = {name: (float(state[name]) if on else 0.0) for name, *_ in BANDS}
    width = 1.0 + (state['amplitud']/100.0 if on else 0.0)       # 1 normal .. 2 muy amplio
    cross = 0.45*state['auriculares']/100.0 if on else 0.0        # mezcla al oido opuesto
    boost = max([0.0] + list(gains.values()))
    # Compensacion: el maximo realce, la energia extra del lado (S) y el cruce
    # no deben llevar la senal por encima de 0 dBFS.
    headroom = 10**(-boost/20.0)/(math.sqrt(width)*(1.0+cross))
    values = {}
    for side in ('l', 'r'):
        for name, *_ in BANDS: values[f'{name}_{side}:Gain'] = round(gains[name], 2)
        values[f'mezcla_{side}:Gain 1'] = round(headroom*(1+width)/2, 5)   # mismo lado
        values[f'mezcla_{side}:Gain 2'] = round(headroom*(1-width)/2, 5)   # lado opuesto (resta = amplitud)
        values[f'mezcla_{side}:Gain 3'] = round(headroom*cross, 5)         # cruce de auriculares
    if limiter:
        gain = state['intensidad'] if on else 0.0
        values['limite:Input gain (dB)'] = gain
        values['limite:Limit (dB)'] = -1.0 if gain else 0.0
    return values


def graph(state, limiter=False):
    """Texto SPA-JSON del filter-chain con los valores guardados como inicio."""
    values = controls(state, limiter)
    nodes, links = [], []
    for side, other in (('l', 'r'), ('r', 'l')):
        previous = None
        for name, label, freq, q in BANDS:
            node = f'{name}_{side}'
            nodes.append(f'{{ type = builtin name = {node} label = {label} '
                         f'control = {{ "Freq" = {freq} "Q" = {q} "Gain" = {values[node+":Gain"]} }} }}')
            if previous: links.append(f'{{ output = "{previous}:Out" input = "{node}:In" }}')
            previous = node
        nodes.append(f'{{ type = builtin name = cruce_paso_{side} label = bq_lowpass '
                     f'control = {{ "Freq" = {CROSSFEED_CUTOFF} "Q" = 0.5 }} }}')
        nodes.append(f'{{ type = builtin name = cruce_retardo_{side} label = delay '
                     f'config = {{ "max-delay" = 0.01 }} control = {{ "Delay (s)" = {CROSSFEED_DELAY} }} }}')
        mix = f'mezcla_{side}'
        nodes.append(f'{{ type = builtin name = {mix} label = mixer control = {{ '
                     + ' '.join(f'"Gain {i}" = {values[f"{mix}:Gain {i}"]}' for i in (1, 2, 3)) + ' } }')
        last = f'{BANDS[-1][0]}_{side}'
        links += [f'{{ output = "{last}:Out" input = "mezcla_{side}:In 1" }}',
                  f'{{ output = "{last}:Out" input = "mezcla_{other}:In 2" }}',
                  f'{{ output = "{last}:Out" input = "cruce_paso_{side}:In" }}',
                  f'{{ output = "cruce_paso_{side}:Out" input = "cruce_retardo_{side}:In" }}',
                  f'{{ output = "cruce_retardo_{side}:Out" input = "mezcla_{other}:In 3" }}']
    outputs = '"mezcla_l:Out" "mezcla_r:Out"'
    if limiter:
        nodes.append(f'{{ type = ladspa name = limite plugin = "{LIMITER}" '
                     'label = fastLookaheadLimiter control = { '
                     f'"Input gain (dB)" = {values["limite:Input gain (dB)"]} '
                     f'"Limit (dB)" = {values["limite:Limit (dB)"]} "Release time (s)" = 0.12 }} }}')
        links += ['{ output = "mezcla_l:Out" input = "limite:Input 1" }',
                  '{ output = "mezcla_r:Out" input = "limite:Input 2" }']
        outputs = '"limite:Output 1" "limite:Output 2"'
    indent = '\n                '
    return f'''# Generado por ultra-sonido; se reescribe en cada inicio de sesion.
context.modules = [
    {{ name = libpipewire-module-filter-chain
        flags = [ nofail ]
        args = {{
            node.description = "ULTRA Sonido"
            media.name       = "ULTRA Sonido"
            filter.graph = {{
                nodes = [{indent}{indent.join(nodes)}
                ]
                links = [{indent}{indent.join(links)}
                ]
                inputs  = [ "graves_l:In" "graves_r:In" ]
                outputs = [ {outputs} ]
            }}
            capture.props = {{
                node.name      = "{NODE}"
                media.class    = Audio/Sink
                audio.position = [ FL FR ]
                filter.smart      = true
                filter.smart.name = ultra-sonido
            }}
            playback.props = {{
                node.name      = "{NODE}.salida"
                node.passive   = true
                audio.position = [ FL FR ]
                stream.dont-remix = true
            }}
        }}
    }}
]
'''


# ---------- PipeWire en vivo ----------
def dump(*args):
    try:
        raw = subprocess.run(['pw-dump', *args], capture_output=True, text=True, timeout=5, check=True).stdout
        return json.loads(raw)
    except (OSError, ValueError, subprocess.SubprocessError): pass
    return []


def audio_node(objects, name):
    for obj in objects:
        info = obj.get('info') or {}
        if obj.get('type') == 'PipeWire:Interface:Node' and (info.get('props') or {}).get('node.name') == name:
            return obj
    return {}


def live_controls(node):
    values = {}
    for prop in ((node.get('info') or {}).get('params') or {}).get('Props', []):
        pairs = prop.get('params') or []
        values.update(zip(pairs[::2], pairs[1::2]))
    return values


def expected_controls(state, actual):
    limiter = 'limite:Input gain (dB)' in actual
    if state['activo'] and state['intensidad'] and not limiter:
        return None
    return controls(state, limiter)


def matches(expected, actual):
    return expected is not None and all(
        isinstance(actual.get(key), (int, float)) and abs(actual[key] - value) < 0.001
        for key, value in expected.items()
    )


def apply(state):
    node = audio_node(dump(), NODE)
    ident = node.get('id')
    if ident is None: return False
    actual = live_controls(node)
    expected = expected_controls(state, actual)
    if expected is None: return False
    if matches(expected, actual): return True
    params = ' '.join(f'"{key}" {float(value):.5f}' for key, value in expected.items())
    result = subprocess.run(['pw-cli', 'set-param', str(ident), 'Props', f'{{ params = [ {params} ] }}'],
                            capture_output=True, text=True, timeout=5)
    if result.returncode: return False
    for _ in range(3):
        if matches(expected, live_controls(audio_node(dump(str(ident)), NODE))):
            return True
        time.sleep(.05)
    return False


def device():
    try:
        out = subprocess.run(['wpctl', 'inspect', '@DEFAULT_AUDIO_SINK@'], capture_output=True, text=True, timeout=3).stdout
        for line in out.splitlines():
            if 'node.description' in line: return line.split('=', 1)[1].strip().strip('"')[:48]
    except (OSError, subprocess.SubprocessError): pass
    return 'sin dispositivo'


def volume():
    try:
        out = subprocess.run(['wpctl', 'get-volume', '@DEFAULT_AUDIO_SINK@'], capture_output=True, text=True, timeout=3).stdout
        parts = out.split()
        return round(float(parts[1])*100), 'MUTED' in out
    except (OSError, ValueError, IndexError, subprocess.SubprocessError):
        return 0, False


def status(state=None):
    state = state or load()
    vol, muted = volume()
    objects = dump()
    node = audio_node(objects, NODE)
    output = audio_node(objects, NODE+'.salida')
    actual = live_controls(node)
    expected = expected_controls(state, actual)
    device_name = device()
    linked = any(obj.get('type') == 'PipeWire:Interface:Link'
                 and (obj.get('info') or {}).get('output-node-id') == output.get('id')
                 and (obj.get('info') or {}).get('state') == 'active' for obj in objects) if output else False
    if not node:
        message = 'Filtro no cargado · reinicia la sesión'
    elif expected is None:
        message = 'Limitador no disponible · actualiza o reinicia ULTRA'
    elif not matches(expected, actual):
        message = 'Ajustes guardados · aplicación pendiente'
    elif not state['activo']:
        message = 'Efectos desactivados'
    elif not linked and device_name in ('ULTRA Sonido', 'sin dispositivo'):
        message = 'Selecciona un dispositivo en Salidas y apps'
    elif not linked:
        message = 'Ajustes aplicados · esperando audio en la salida principal'
    else:
        message = 'Audio pasando por ULTRA Sonido'
    return dict(state, motor=bool(node), mensaje=message, dispositivo=device_name, volumen=vol, silencio=muted)


# ---------- panel eww ----------
def eww(*args, timeout=8):
    return subprocess.run(['eww', '--config', str(EWW_DIR), *args], stdin=subprocess.DEVNULL,
                          capture_output=True, text=True, timeout=timeout)


def panel():
    # eww exige los nombres eww.yuck/eww.scss: copia propia y separada de las tarjetas.
    EWW_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    for src, dst in (('sonido.yuck', 'eww.yuck'), ('sonido.scss', 'eww.scss')):
        data = (EWW_SRC/src).read_text()
        if not (EWW_DIR/dst).is_file() or (EWW_DIR/dst).read_text() != data: atomic(EWW_DIR/dst, data, 0o644)
    if eww('ping', timeout=2).returncode:
        subprocess.Popen(['eww', '--config', str(EWW_DIR), 'daemon'], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        for _ in range(30):
            if not eww('ping', timeout=2).returncode: break
            time.sleep(.1)
    action = 'close' if 'sonido' in eww('active-windows').stdout else 'open'
    result = eww(action, 'sonido')
    if result.returncode:
        raise ValueError(result.stderr.strip() or 'No se pudo abrir el panel de sonido')


def listen():
    last = None
    while True:
        current = json.dumps(status(), sort_keys=True)
        if current != last:
            print(current, flush=True); last = current
        time.sleep(.7)


def notify(text):
    try: subprocess.run(['notify-send', '--app-name=ULTRA', '--icon=audio-speakers', 'ULTRA Sonido', text], timeout=3)
    except (OSError, subprocess.SubprocessError): pass


def change(action, args):
    STATE.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with STATE.with_suffix('.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = load()
        if action == 'poner':
            state[args[1]] = clamp(args[1], args[2])
            state['perfil'] = 'personal'
        elif action == 'perfil':
            state.update(PROFILES[args[1]], perfil=args[1], activo=True)
        else:
            state['activo'] = {'alternar': not state['activo'], 'activar': True, 'desactivar': False}[action]
        save(state)
        return apply(state)


def main():
    if os.geteuid() != 1000: raise ValueError('abrir como usuario del escritorio')
    args = sys.argv[1:]
    action = args[0] if args else 'panel'
    if action == 'preparar':
        atomic(PW_CONF, graph(load(), LIMITER.is_file()), 0o644)
    elif action == 'panel': panel()
    elif action == 'estado': print(json.dumps(status()))
    elif action == 'escuchar': listen()
    elif (action == 'poner' and len(args) == 3 and args[1] in RANGES
          or action == 'perfil' and len(args) == 2 and args[1] in PROFILES
          or action in ('alternar', 'activar', 'desactivar') and len(args) == 1):
        if not change(action, args) and action != 'poner':
            notify('Ajustes guardados. El panel indica si el filtro está disponible.')
    elif action == 'volumen' and len(args) == 2:
        value = max(0, min(150, int(float(args[1]))))
        subprocess.run(['wpctl', 'set-volume', '--limit', '1.5', '@DEFAULT_AUDIO_SINK@', f'{value}%'], timeout=3, check=True)
    elif action == 'silencio':
        subprocess.run(['wpctl', 'set-mute', '@DEFAULT_AUDIO_SINK@', 'toggle'], timeout=3, check=True)
    else:
        raise ValueError('Uso: ultra-sonido preparar|panel|estado|escuchar|poner CLAVE VALOR|perfil NOMBRE|alternar|volumen N')


if __name__ == '__main__':
    try: main()
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print('Sonido:', error, file=sys.stderr); sys.exit(1)
