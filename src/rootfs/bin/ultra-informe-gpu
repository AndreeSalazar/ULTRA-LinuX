#!/usr/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
# Invoked by the privileged preparer on exit, including failed device preparation.
set -uo pipefail
[[ $(id -u) == 0 ]] || exit 1
out=/run/ultra-escritorio/informe-gpu.txt
tmp=$out.$$
{
    printf 'ULTRA GPU - ultimo intento\n'
    date -u '+fecha_utc=%Y-%m-%dT%H:%M:%SZ'
    TZ=America/Lima date '+fecha_local=%Y-%m-%dT%H:%M:%S%:z'
    printf 'zona_horaria=America/Lima\n'
    printf 'kernel=%s\nmodo=%s\ncompositor=%s\nsalida=%s\n' "$(uname -r)" "${1:-?}" "${2:-?}" "${3:-?}"
    printf '\n[NODOS: estado posterior al intento, sin ejecutar nvidia-smi]\n'
    for node in /dev/nvidia0 /dev/nvidiactl /dev/nvidia-modeset /dev/dri/card* /dev/dri/renderD*; do
        if [[ -e $node ]]; then
            stat -c '%n tipo=%F major_minor_hex=%t:%T uid=%u gid=%g permisos=%a' -- "$node"
        else printf 'AUSENTE %s\n' "$node"; fi
    done
    printf '\n[DRIVER]\n'
    for file in /proc/driver/nvidia/version /proc/driver/nvidia/gpus/*/information; do
        [[ ! -r $file ]] || { printf '%s\n' "$file"; cat "$file"; }
    done
    printf '\n[PREPARACION DE NODOS]\n'
    [[ ! -r /run/ultra-escritorio/nodos.log ]] || cat /run/ultra-escritorio/nodos.log
    printf '\n[RED: preparacion de esta sesion]\n'
    if [[ -r /run/ultra-escritorio/red.log ]]; then cat /run/ultra-escritorio/red.log;
    else printf 'NA: no se llego a preparar la red\n'; fi
    /usr/bin/bash /usr/local/libexec/ultra-informe-red
    printf '\n[AUDIO: tarjetas, nodos y ultimo estado del servidor de usuario]\n'
    cat /proc/asound/cards /proc/asound/pcm 2>/dev/null || true
    ls -l /dev/snd 2>/dev/null || true
    [[ ! -r /run/user/1000/ultra-audio-estado.txt ]] || cat /run/user/1000/ultra-audio-estado.txt
    for home in /home/ultra /juegos/usuarios/ultra; do
        for log in pipewire pipewire-pulse wireplumber; do
            file=$home/.cache/ultra/$log.log
            [[ ! -r $file ]] || { printf '\n%s\n' "$file"; tail -n 40 "$file"; }
        done
    done
    printf '\n[JUEGOS: montaje y espacio, sin exportar cuentas o credenciales]\n'
    [[ ! -r /run/ultra-escritorio/juegos.log ]] || cat /run/ultra-escritorio/juegos.log
    [[ ! -r /run/ultra-escritorio/warframe.log ]] || cat /run/ultra-escritorio/warframe.log
    [[ ! -r /run/ultra-escritorio/bibliotecas.log ]] || cat /run/ultra-escritorio/bibliotecas.log
    # Query mountpoints separately: two positional arguments mean source + target.
    for target in /juegos /juegos/Cyberpunk2077 /juegos/Warframe; do
        findmnt --mountpoint "$target" --output TARGET,FSTYPE,OPTIONS 2>/dev/null ||
            printf 'NO MONTADO %s\n' "$target"
    done
    mountpoint -q /juegos && df -h /juegos || true
    printf '\n[REGISTRO DE BIBLIOTECAS STEAM: sin cuentas o sesiones]\n'
    setpriv --reuid=1000 --regid=1000 --init-groups --no-new-privs \
        --inh-caps=-all --ambient-caps=-all --bounding-set=-all \
        timeout -k 1 2 head -c 16384 /juegos/usuarios/ultra/.cache/ultra/steam-bibliotecas.log 2>/dev/null || true
    printf '\n[MEDICION DURANTE LA SESION: no es consumo posterior al cierre]\n'
    printf '\n[HUD: paquetes y preferencia nativa, sin cuentas]\n'
    pacman -Q mangohud lib32-mangohud 2>/dev/null || true
    setpriv --reuid=1000 --regid=1000 --init-groups --no-new-privs \
        --inh-caps=-all --ambient-caps=-all --bounding-set=-all \
        env HOME=/juegos/usuarios/ultra timeout -k 1 3 ultra-hud-heronite estado 2>/dev/null || true
    printf '\n[VIGILANTE: observaciones recientes; sin ajustes automaticos]\n'
    if read -r vigilante_inicio < /run/ultra-escritorio/vigilante-inicio; then
        setpriv --reuid=1000 --regid=1000 --init-groups --no-new-privs \
            --inh-caps=-all --ambient-caps=-all --bounding-set=-all \
            env HOME=/juegos/usuarios/ultra timeout -k 1 3 /usr/local/bin/ultra-vigilante informe "$vigilante_inicio" 2>/dev/null || printf 'VIGILANTE NA sin informe de la sesion\n'
    else printf 'VIGILANTE NA inicio de sesion no registrado\n'; fi
    printf '\n[/VIGILANTE]\n'
    printf '\n[CAPTURA: ultimo resultado; sin exportar imagenes]\n'
    setpriv --reuid=1000 --regid=1000 --init-groups --no-new-privs \
        --inh-caps=-all --ambient-caps=-all --bounding-set=-all \
        env HOME=/juegos/usuarios/ultra timeout -k 1 3 /usr/local/bin/ultra-captura estado 2>/dev/null || printf 'CAPTURA NA registro no disponible\n'
    printf '\n[PUNTERO RED: solo reparaciones de imagen transparente]\n'
    setpriv --reuid=1000 --regid=1000 --init-groups --no-new-privs \
        --inh-caps=-all --ambient-caps=-all --bounding-set=-all \
        env XDG_RUNTIME_DIR=/run/user/1000 timeout -k 1 3 ultra-puntero-red estado 2>/dev/null || true
    if [[ -r /run/ultra-escritorio/cpu-energia.json ]]; then
        printf '\n[CPU: temperatura etiquetada, perfil y RAPL; ultimas 300 muestras]\n'
        head -c 1048576 /run/ultra-escritorio/cpu-energia.json
        printf '\n[/CPU ENERGIA]\n'
    fi
    printf '\n[WINDOWS NVME: solo metadatos de montaje]\n'
    [[ ! -r /run/ultra-escritorio/windows.log ]] || cat /run/ultra-escritorio/windows.log
    printf '\n[DIAGNOSTICO GRAFICO SOLICITADO POR EL USUARIO]\n'
    if [[ -f /run/user/1000/ultra-graficos.txt ]]; then
        setpriv --reuid=1000 --regid=1000 --init-groups --no-new-privs \
            --inh-caps=-all --ambient-caps=-all --bounding-set=-all \
            timeout -k 1 2 head -c 131072 /run/user/1000/ultra-graficos.txt || true
    fi
    if [[ -r /run/ultra-escritorio/medicion.log ]]; then
        cat /run/ultra-escritorio/medicion.log
    else printf 'NA: la sesion no llego a iniciar el observador\n'; fi
    printf '\n[KERNEL: GPU y audio, ultimas 70 coincidencias]\n'
    printf '\n[LIMITES DE RECURSOS: contadores globales de la sesion]\n'
    for key in memory.current memory.high memory.max memory.events pids.current pids.max; do
        file=/sys/fs/cgroup/ultra-usuario/$key
        if [[ -r $file ]]; then printf '%s: ' "$key"; head -c 4096 "$file"; printf '\n'; fi
    done
    [[ ! -r /run/ultra-escritorio/limites.log ]] || head -c 4096 /run/ultra-escritorio/limites.log
    printf '\n[DIAGNOSTICO WARFRAME: resumen acotado, sin registros privados]\n'
    if mountpoint -q /juegos; then
        setpriv --reuid=1000 --regid=1000 --init-groups --no-new-privs --bounding-set=-all --inh-caps=-all --ambient-caps=-all \
            /usr/bin/env HOME=/juegos/usuarios/ultra /usr/bin/timeout -k 1 12 /usr/local/bin/ultra-diagnostico-juego exportar 2>/dev/null | head -c 131072
        printf '\n'
    fi
    printf '\n[KERNEL: GPU y audio, ultimas 70 coincidencias]\n'
    dmesg | grep -Ei 'NVRM|nvidia|drm|snd_hda|snd_usb|snd-usb|USB Audio|usbaudio' | tail -n 70
    printf '\n[LANZAMIENTO DEL CLIENTE: puede faltar si la preparacion fallo]\n'
    [[ ! -r /run/ultra-escritorio/ultima.log ]] || tail -n 160 /run/ultra-escritorio/ultima.log
} > "$tmp" 2>&1
mv -f -- "$tmp" "$out"
if [[ ${3:-0} != 0 ]]; then cp -- "$out" /run/ultra-escritorio/informe-gpu-fallo.txt; fi
