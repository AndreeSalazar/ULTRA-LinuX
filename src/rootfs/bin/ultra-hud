#!/usr/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
set -euo pipefail
[[ $(id -u) == 1000 ]] || exit 1
state="$HOME/.config/ultra/hud-desactivado"
action=${1:-menu}; shift || true
if [[ $action == menu ]]; then
    choice=$(printf '%s\n' 'Ver juegos y consumo en vivo' 'Activar HUD para nuevos lanzamientos' 'Desactivar HUD para nuevos lanzamientos' 'Abrir registros de FPS' |
        fuzzel --dmenu --only-match --prompt='FPS / Rendimiento / ' --lines=4) || exit 0
    case $choice in
        'Ver juegos y consumo en vivo') exec foot --title='ULTRA / Juegos en vivo' ultra-juegos-vivo panel;;
        'Activar HUD para nuevos lanzamientos') action=activar;;
        'Desactivar HUD para nuevos lanzamientos') action=desactivar;;
        'Abrir registros de FPS') mkdir -p "$HOME/.cache/ultra/rendimiento"; exec thunar "$HOME/.cache/ultra/rendimiento";;
        *) exit 0;;
    esac
fi
umask 077
case $action in
    activar|desactivar)
        mkdir -p "${state%/*}"
        if [[ $action == activar ]]; then rm -f -- "$state"; else : > "$state"; fi
        ultra-hud-heronite sincronizar || true
        notify-send 'HUD de juegos' 'Cambio guardado. Cierra y abre Steam/Heronite para los proximos juegos. En un juego con HUD: Shift derecho + F12 para mostrar/ocultar.' || true
        exit 0;;
    ejecutar|opengl) (( $# )) || exit 2;;
    *) exit 2;;
esac
if [[ -e $state && ${ULTRA_DIAGNOSTICO_HUD:-0} != 1 ]]; then
    export MANGOHUD=0
    exec "$@"
fi
mkdir -p "$HOME/.config/ultra" "$HOME/.cache/ultra/rendimiento"
config="$HOME/.config/ultra/MangoHud.conf"
if [[ ! -e $config ]]; then
    temp=$(mktemp "$HOME/.config/ultra/.hud-XXXXXX")
    trap 'rm -f -- "$temp"' EXIT
    cat /etc/ultra/MangoHud.conf > "$temp"
    printf '\noutput_folder=%s/.cache/ultra/rendimiento\n' "$HOME" >> "$temp"
    mv -- "$temp" "$config"
    trap - EXIT
fi
export MANGOHUD=1 MANGOHUD_CONFIGFILE="$config"
if [[ ${1:-} == /usr/bin/heronite-rs ]]; then
    # Existing personal HUD files survive image updates. Extend only the
    # launcher's exclusion; games still inherit their normal HUD configuration.
    /usr/bin/python - "$config" <<'PY'
import os
from pathlib import Path
import tempfile
import sys
p=Path(sys.argv[1])
if p.is_symlink() or not p.is_file() or p.stat().st_uid!=os.getuid() or p.stat().st_size>65536:
    raise SystemExit('HUD: configuracion no regular; se conserva')
raw=p.read_text()
rows=[line.split('=',1)[1].strip() for line in raw.splitlines() if line.strip().startswith('blacklist=')]
names=[name.strip() for name in rows[-1].split(',')] if rows else []
required=['heronite-rs','heronite-epic-login']
if not all(name in names for name in required):
    names.extend(name for name in required if name not in names)
    fd,tmp=tempfile.mkstemp(prefix='.hud-heronite-',dir=p.parent)
    try:
        with os.fdopen(fd,'w') as stream:
            os.fchmod(stream.fileno(),0o600)
            stream.write(raw.rstrip('\n')+'\nblacklist='+','.join(names)+'\n')
        os.replace(tmp,p)
    finally:
        if os.path.exists(tmp):os.unlink(tmp)
PY
fi
if [[ ${ULTRA_DIAGNOSTICO_HUD:-0} == 1 && -f /run/user/1000/ultra-diagnostico/MangoHud.conf ]]; then
    export MANGOHUD_CONFIGFILE=/run/user/1000/ultra-diagnostico/MangoHud.conf
fi
if [[ $action == opengl ]]; then exec mangohud "$@"; fi
exec "$@"
