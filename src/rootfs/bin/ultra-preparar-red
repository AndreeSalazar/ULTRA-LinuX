#!/usr/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
# Wired IPv4 DHCP only. No Wi-Fi credentials or hardcoded public DNS.
set -uo pipefail
[[ $(id -u) == 0 ]] || exit 1
exec 9>&- # DHCP may outlive the desktop; never retain its session lock.
exec 8>/run/ultra-red-preparar.lock
flock -w 2 8 || { echo 'AMARILLO [RED]: otra preparacion esta en curso'; exit 1; }
printf 'ULTRA RED\n'
supervisor_active() {
    local pidfile pid permissions executable process_uid service_uid
    pidfile=$(timeout -k 1 1 dhcpcd -4 --printpidfile "$1" 2>/dev/null) || return 1
    [[ $pidfile == /run/* && -f $pidfile && ! -L $pidfile ]] || return 1
    [[ $(stat -c %u -- "$pidfile") == 0 ]] || return 1
    permissions=$(stat -c %a -- "$pidfile") || return 1
    [[ $permissions =~ ^[0-7]{3,4}$ ]] && (( (8#$permissions & 022) == 0 )) || return 1
    pid=$(head -c 32 -- "$pidfile")
    [[ $pid =~ ^[1-9][0-9]{0,9}$ && -r /proc/$pid/status ]] || return 1
    process_uid=$(awk '/^Uid:/{print $2; exit}' "/proc/$pid/status")
    service_uid=$(id -u dhcpcd 2>/dev/null) || service_uid=0
    # The master may run as dhcpcd's privilege-separated service account.
    [[ $process_uid == 0 || $process_uid == "$service_uid" ]] || return 1
    grep -Eq '^State:[[:space:]]+Z' "/proc/$pid/status" && return 1
    # /proc/exe can show an outer /arch path while we run in chroot. Compare
    # the executable inode through the proc magic link, not that printed path.
    executable=$(stat -Lc '%d:%i' -- "/proc/$pid/exe") || return 1
    [[ $executable == "$(stat -Lc '%d:%i' -- "$(command -v dhcpcd)")" ]]
}
# Local IPC over TCP must work even with Ethernet unplugged (Steam WebUI, etc.).
ip link set dev lo up || { echo 'ROJO [RED]: no se pudo activar loopback'; exit 1; }
ready() {
    local route iface i routes
    routes=$(ip -4 route show default) || return 1
    while read -r -a route; do
        [[ ${route[0]:-} == default && " ${route[*]} " != *' linkdown '* ]] || continue
        iface=''
        for ((i=0;i+1<${#route[@]};i++)); do
            [[ ${route[i]} != dev ]] || { iface=${route[i+1]}; break; }
        done
        [[ -n $iface && $iface =~ ^[a-zA-Z0-9_.:-]+$ ]] || continue
        [[ $(cat "/sys/class/net/$iface/carrier" 2>/dev/null) == 1 ]] || continue
        ip -4 -o address show dev "$iface" scope global | grep -q ' inet ' || continue
        # Presence is reported separately; it does not prove DNS/HTTPS reachability.
        grep -Eq '^[[:space:]]*nameserver[[:space:]]+[^[:space:]#;]+' /etc/resolv.conf || continue
        return 0
    done <<< "$routes"
    return 1
}
show_ready() {
    ip -4 -brief address
    ip -4 route show default
    echo 'VERDE [RED]: enlace, IPv4, ruta y DNS configurados; acceso DNS/HTTPS aun sin comprobar'
}
if ready; then show_ready; exit 0; fi
count=0; launched=0; fresh=0; deadline=$((SECONDS+12))
for entry in /sys/class/net/*; do
    iface=${entry##*/}
    [[ $iface != lo && $iface =~ ^[a-zA-Z0-9_.:-]+$ && ! -d $entry/wireless ]] || continue
    [[ $(cat "$entry/type" 2>/dev/null) == 1 ]] || continue
    ((count+=1)); ((count <= 4)) || break
    ip link set dev "$iface" up || continue
    if supervisor_active "$iface"; then
        ((launched+=1))
        printf 'RED DHCP supervisor reutilizado interfaz=%s\n' "$iface"
        continue
    fi
    remaining=$((deadline-SECONDS)); ((remaining>0)) || break
    ((remaining<=3)) || remaining=3
    # Start even without carrier. dhcpcd watches link changes and keeps trying
    # when a cable is connected AFTER the bounded foreground wait has ended.
    if timeout -k 1 "$remaining" dhcpcd -4 --background --timeout 0 "$iface" 8>&-; then
        ((launched+=1))
        ((fresh+=1))
        printf 'RED DHCP supervisor iniciado interfaz=%s\n' "$iface"
    fi
done
if ((fresh)); then
    while ((SECONDS<deadline)); do
        if ready; then show_ready; exit 0; fi
        sleep .2
    done
fi
printf 'AMARILLO [RED]: IPv4/ruta/DNS pendientes; supervisores DHCP=%s; el escritorio puede abrir sin internet\n' "$launched"
ip -4 -brief address
ip -4 route show default
exit 1
