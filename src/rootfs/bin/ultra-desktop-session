#!/usr/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
set -uo pipefail
[[ $(id -u) == 1000 ]] || exit 1
umask 077
mkdir -p "$HOME/.cache/ultra"
keyrings="${XDG_DATA_HOME:-$HOME/.local/share}/keyrings"
mkdir -p "$keyrings"
chmod 0700 "$keyrings"
children=()
ultra-espacio vigilar > /dev/null 2>&1 & children+=("$!")
ultra-usb vigilar > "$HOME/.cache/ultra/usb.log" 2>&1 & children+=("$!")
finish() {
    wpctl status > "$XDG_RUNTIME_DIR/ultra-audio-estado.txt" 2>&1 || true
    for pid in "${children[@]}"; do kill "$pid" 2>/dev/null || true; done
    for pid in "${children[@]}"; do wait "$pid" 2>/dev/null || true; done
}
trap finish EXIT
# No PAM password reaches this autologin desktop. Let the graphical prompt
# create/unlock an encrypted keyring; never feed an empty password to the daemon.
gnome-keyring-daemon --start --foreground --components=secrets \
    > "$HOME/.cache/ultra/llavero.log" 2>&1 & children+=("$!")
# ULTRA Sonido: write the filter-chain with saved settings before PipeWire reads its config.
ultra-sonido preparar 2> "$HOME/.cache/ultra/sonido.log" || true
pipewire > "$HOME/.cache/ultra/pipewire.log" 2>&1 & children+=("$!")
pipewire-pulse > "$HOME/.cache/ultra/pipewire-pulse.log" 2>&1 & children+=("$!")
wireplumber > "$HOME/.cache/ultra/wireplumber.log" 2>&1 & children+=("$!")
if [[ $HOME == /juegos/usuarios/ultra ]]; then
    # Acceso directo al disco Personal (ext4 en el antiguo D:) cuando esta montado.
    [[ -e $HOME/Personal || -L $HOME/Personal || ! -d /personal/ultra || ! -O /personal/ultra ]] || ln -s /personal/ultra "$HOME/Personal"
    ultra-juegos-vivo vigilar > "$HOME/.cache/ultra/juegos-vivo.log" 2>&1 & children+=("$!")
    # Daily local backup of settings and saves, idle I/O priority, after login settles.
    (sleep 180; exec nice -n 19 ionice -c 3 ultra-respaldo crear --auto) \
        > "$HOME/.cache/ultra/respaldo.log" 2>&1 & children+=("$!")
fi
start-hyprland -- --config /etc/ultra/hyprland.lua
exit $?
