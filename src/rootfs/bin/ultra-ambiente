#!/usr/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
# Session controls only: no root, hardware tuning, external commands from labels or eval.
set -euo pipefail
[[ $(id -u) == 1000 ]] || exit 1
mode=${1:-menu}
if [[ $mode == menu ]]; then
    ultra-personalizar sonar menu > /dev/null 2>&1 &
    category=raiz
    remembered="${XDG_RUNTIME_DIR:?}/ultra-categoria"
    previous=apps
    personal=$(ultra-personalizar acento 2>/dev/null || true)
    [[ $personal =~ ^[0-9a-f]{8}$ ]] || personal=5ad8ffff
    [[ ! -f $remembered ]] || read -r previous < "$remembered" || true
    pick() {
        printf '%s\n' "$@" | fuzzel --dmenu --only-match --no-sort --width=48 \
            --lines="$#" --prompt="$title / " --select-index="$index" \
            --background-color=06050af7 --text-color=ece9dcff \
            --selection-color="$accent" --selection-text-color=000000ff \
            --border-color="$accent" --prompt-color="$accent" \
            --match-color="$accent" --selection-match-color=000000ff
    }
    while true; do
        index=0
        case $category in
            raiz)
                title='BMO-X // Categorias'; accent=$personal
                case $previous in apps) index=0;; discos) index=1;; juegos) index=2;; pantalla) index=3;; audio) index=4;; ambiente) index=5;; sistema) index=6;; esac
                rows=('1 Aplicaciones' '2 Discos y bibliotecas' '3 Juegos' '4 Pantalla y graficos' '5 Audio' '6 Ambiente' '7 Sistema y ayuda');;
            apps) title='Aplicaciones / ACENTO'; accent=$personal
                rows=('Buscar aplicaciones' 'Navegador Brave' 'Archivos' 'Carpetas BMO-X' 'Terminal' 'Editor' 'Volver a categorias');;
            discos) title='Discos / CYAN'; accent=00f0ffff
                rows=('Panel de discos y preparacion' 'Carpetas guardadas' 'Windows NVMe (solo lectura)' 'Explorar discos (solo lectura)' 'Volver a categorias');;
            juegos) title='Juegos / ROJO'; accent=ff2a4fff
                rows=('Steam' 'GOG / Heroic' 'Importar juegos GOG' 'Warframe / Steam' 'Cyberpunk 2077' 'Revisar bibliotecas de juegos' 'Juegos y consumo en vivo' 'FPS y HUD' 'Espacio y estado de juegos' 'Volver a categorias');;
            pantalla) title='Pantalla / VERDE'; accent=3dff9aff
                rows=('Resolucion, Hz y escala' 'Informe Vulkan y OpenGL' 'Cubo Vulkan' 'Cubo Vulkan con validacion' 'Volver a categorias');;
            audio) title='Audio / VIOLETA'; accent=c03bffff
                rows=('Salidas y volumen por aplicacion' 'Subir volumen' 'Bajar volumen' 'Silencio' 'Volumen 100%' 'Amplificar 125%' 'Amplificar 150%' 'Amplificar 200%' 'Amplificar 300%' 'Amplificar 400%' 'Amplificar 500%' 'Volver a categorias');;
            ambiente) title='Ambiente / AMARILLO'; accent=fcee0aff
                rows=('Personalizar escritorio' 'Efectos vivos' 'Efectos reducidos' 'Limpiar notificaciones' 'Recuperar ultimo aviso' 'Historial del portapapeles' 'Volver a categorias');;
            sistema) title='Sistema / CORAL'; accent=ff7a90ff
                rows=('Ayuda y atajos' 'RAM, GPU y espacio' 'Estado del audio' 'Registros de juegos' 'Equipo en vivo' 'Administrador de aplicaciones' 'Limpiar registros ULTRA antiguos' 'Guardar incidente' 'Abrir incidentes' 'Volver a categorias');;
            *) exit 2;;
        esac
        if ! choice=$(pick "${rows[@]}"); then
            [[ $category != raiz ]] || exit 0
            category=raiz; continue
        fi
        if [[ $category == raiz ]]; then
            case $choice in
                '1 Aplicaciones') category=apps;; '2 Discos y bibliotecas') category=discos;;
                '3 Juegos') category=juegos;; '4 Pantalla y graficos') category=pantalla;;
                '5 Audio') category=audio;; '6 Ambiente') category=ambiente;;
                '7 Sistema y ayuda') category=sistema;; *) exit 0;;
            esac
            previous=$category
            (umask 077; printf '%s\n' "$category" > "$remembered")
            continue
        fi
        [[ $choice != 'Volver a categorias' ]] || { category=raiz; continue; }
        break
    done
    case $choice in
        'Buscar aplicaciones') exec ultra-personalizar lanzador;;
        'Navegador Brave') exec ultra-brave;;
        Archivos) exec thunar;;
        'Carpetas BMO-X') exec ultra-carpetas;;
        'Panel de discos y preparacion') exec foot --fullscreen --title='ULTRA / Discos y bibliotecas' /usr/local/bin/ultra-discos panel;;
        'Carpetas guardadas') exec foot --hold /usr/local/bin/ultra-bibliotecas estado;;
        'Windows NVMe (solo lectura)') exec ultra-windows;;
        'Explorar discos (solo lectura)') exec thunar /discos;;
        'Resolucion, Hz y escala') exec ultra-pantallas menu;;
        'Informe Vulkan y OpenGL') exec foot --hold /usr/local/bin/ultra-graficos informe;;
        'Cubo Vulkan') exec ultra-graficos cubo;;
        'Cubo Vulkan con validacion') exec ultra-graficos validar;;
        Terminal) exec foot;;
        Editor) exec mousepad;;
        Steam) exec ultra-juegos steam;;
        'GOG / Heroic') exec ultra-juegos gog;;
        'Importar juegos GOG') exec ultra-bibliotecas importar-gog;;
        'Warframe / Steam') exec ultra-juegos warframe;;
        'Cyberpunk 2077') exec ultra-juegos cyberpunk;;
        'Revisar bibliotecas de juegos') exec foot --fullscreen --title='ULTRA / Discos y bibliotecas' /usr/local/bin/ultra-discos panel;;
        'Juegos y consumo en vivo') exec foot --title='ULTRA / Juegos en vivo' ultra-juegos-vivo panel;;
        'FPS y HUD') exec ultra-hud menu;;
        'Espacio y estado de juegos'|'RAM, GPU y espacio') exec foot --hold /usr/local/bin/ultra-juegos estado;;
        'Registros de juegos') exec foot --hold /usr/local/bin/ultra-juegos registros;;
        'Salidas y volumen por aplicacion') exec pavucontrol;;
        'Subir volumen') exec ultra-audio subir;; 'Bajar volumen') exec ultra-audio bajar;;
        Silencio) exec ultra-audio silencio;; 'Volumen 100%') exec ultra-audio normal;;
        'Amplificar 125%') exec ultra-audio boost125;; 'Amplificar 150%') exec ultra-audio boost150;;
        'Amplificar 200%') exec ultra-audio boost200;; 'Amplificar 300%') exec ultra-audio boost300;;
        'Amplificar 400%') exec ultra-audio boost400;; 'Amplificar 500%') exec ultra-audio boost500;;
        'Estado del audio') exec foot --hold /usr/local/bin/ultra-audio estado;;
        'Efectos vivos') mode=vivo;;
        'Efectos reducidos') mode=sobrio;;
        'Limpiar notificaciones') exec makoctl dismiss -a;;
        'Recuperar ultimo aviso') exec makoctl restore;;
        'Historial del portapapeles') exec ultra-portapapeles menu;;
        'Personalizar escritorio') exec ultra-personalizar menu;;
        'Ayuda y atajos') exec foot /usr/bin/less /etc/ultra/AYUDA.txt;;
        'Equipo en vivo') exec foot --title='ULTRA / Equipo en vivo' watch -n 2 ultra-equipo texto;;
        'Administrador de aplicaciones') exec foot --fullscreen --title='ULTRA / Aplicaciones' ultra-aplicaciones;;
        'Limpiar registros ULTRA antiguos') exec foot --hold ultra-espacio limpiar;;
        'Guardar incidente') exec ultra-incidente guardar;;
        'Abrir incidentes') exec ultra-incidente abrir;;
        *) exit 0;;
    esac
fi
state="${XDG_RUNTIME_DIR:?}/ultra-efectos"
if [[ $mode == alternar ]]; then
    previous=${ULTRA_EFECTOS:-vivo}
    [[ ! -f $state ]] || read -r previous < "$state"
    if [[ $previous == vivo ]]; then mode=sobrio; else mode=vivo; fi
fi
case $mode in
    vivo) enabled=true; message='Animaciones, sombras y desenfoque activados';;
    sobrio) enabled=false; message='Animaciones, sombras y desenfoque desactivados';;
    *) printf 'Uso: ultra-ambiente menu|alternar|vivo|sobrio\n' >&2; exit 2;;
esac
hyprctl eval "hl.config({animations={enabled=$enabled},decoration={blur={enabled=$enabled},shadow={enabled=$enabled}}})" >/dev/null
# Con personalizacion guardada, vuelve a poner su desenfoque, esquinas y animaciones para este modo.
ultra-personalizar hyprland "$mode" >/dev/null 2>&1 || true
printf '%s\n' "$mode" > "$state"
notify-send --app-name=ULTRA --icon=preferences-desktop-theme 'BMO-X / Ambiente' "$message" || true
