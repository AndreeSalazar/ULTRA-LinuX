#!/usr/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
set -euo pipefail
[[ $(id -u) == 1000 ]] || exit 1
action=${1:-menu}
if [[ $action == menu ]]; then
    choice=$(printf '%s\n' 'Steam' 'Elegir carpetas y discos' 'Mis carpetas y bibliotecas' 'GOG / Heroic' 'Importar juegos GOG' 'Cyberpunk 2077' 'Cyberpunk / recuperacion y diagnostico' 'Revisar bibliotecas de juegos' 'Warframe / Steam' 'Estado y espacio' 'Registros de juegos' 'Juegos y consumo en vivo' 'FPS y HUD' 'Warframe / diagnostico' 'Warframe / panel de recursos' 'Warframe / capturas guardadas' |
        fuzzel --dmenu --prompt='Juegos /' --lines=16) || exit 0
    case $choice in
        Steam) action=steam;; 'GOG / Heroic') action=gog;; 'Cyberpunk 2077') action=cyberpunk;;
        'Cyberpunk / recuperacion y diagnostico') action=cyberpunk-directo;;
        'Importar juegos GOG') exec ultra-bibliotecas importar-gog;;
        'Warframe / Steam') action=warframe;;
        'Elegir carpetas y discos') exec foot --fullscreen --title='ULTRA / Discos y bibliotecas' /usr/local/bin/ultra-discos panel;;
        'Mis carpetas y bibliotecas') exec foot --hold /usr/local/bin/ultra-bibliotecas estado;;
        'Revisar bibliotecas de juegos') exec foot --fullscreen --title='ULTRA / Discos y bibliotecas' /usr/local/bin/ultra-discos panel;;
        'Estado y espacio') exec foot --hold /usr/local/bin/ultra-juegos estado;;
        'Registros de juegos') exec foot --hold /usr/local/bin/ultra-juegos registros;;
        'Juegos y consumo en vivo') exec foot --title='ULTRA / Juegos en vivo' ultra-juegos-vivo panel;;
        'FPS y HUD') exec ultra-hud menu;;
        'Warframe / diagnostico') action=warframe-diagnostico;;
        'Warframe / panel de recursos') exec foot --title='ULTRA / Warframe diagnostico' ultra-diagnostico-juego panel;;
        'Warframe / capturas guardadas') exec ultra-diagnostico-juego registros;;
        *) exit 0;;
    esac
fi
if [[ $action == warframe-diagnostico ]]; then
    if pgrep -u 1000 -x steam >/dev/null; then
        notify-send 'Warframe / diagnostico' 'Cierra Steam y vuelve a elegir este modo para que el juego reciba el HUD de captura.' || true
        exit 1
    fi
    ultra-diagnostico-juego preparar || exit 1
    # Incluye las esperas previas al lanzador. Solo en el modo elegido por el
    # usuario; el arranque normal no activa un observador adicional.
    ultra-diagnostico-juego iniciar || true
    export ULTRA_DIAGNOSTICO_HUD=1 DXVK_HUD=compiler
    notify-send 'Warframe / diagnostico' 'Captura de recursos solicitada antes de Steam (2 min). Super+Shift+F11 marca la pausa; Shift izquierdo+F2 graba cuadros. Cierra Steam al terminar este modo.' || true
    action=warframe
fi
if [[ $action == estado ]]; then
    ultra-espacio estado
    printf 'ULTRA / Juegos: montajes y espacio\nHOME=%s\n' "$HOME"
    printf '\n[DISCOS: visibles al kernel; no implica biblioteca registrada en Steam]\n'
    lsblk -e 7 -o NAME,TYPE,FSTYPE,SIZE,MOUNTPOINTS || true
    [[ ! -r /run/ultra-bibliotecas.json ]] || /usr/local/bin/ultra-bibliotecas estado || true
    if mountpoint -q /juegos; then
        findmnt --mountpoint /juegos --output TARGET,FSTYPE,OPTIONS || true
        df -h /juegos
    else
        printf 'Almacenamiento de juegos no montado: la sesion puede ser temporal en RAM.\n'
    fi
    for target in /windows /juegos/Warframe /juegos/Cyberpunk2077; do
        findmnt --mountpoint "$target" --output TARGET,FSTYPE,OPTIONS || printf 'NO MONTADO %s\n' "$target"
    done
    printf '\n[WARFRAME]\n'
    [[ ! -r '/windows/Program Files (x86)/Steam/steamapps/common/Warframe/Warframe.x64.exe' ]] || printf 'Archivos originales presentes en C:; no acredita Proton funcionando.\n'
    [[ ! -f $HOME/Juegos/SteamLibrary/steamapps/appmanifest_230410.acf ]] || printf 'Biblioteca preparada: %s/Juegos/SteamLibrary; agregar/verificar en Steam.\n' "$HOME"
    printf 'Cambios, Proton y caches comparten el espacio ext4. Una actualizacion puede requerir muchos GiB.\n'
    printf '\n[RAM: sistema completo, no VRAM]\n'
    free -h || true
    printf '\n[VRAM: instantanea NVIDIA, si esta disponible]\n'
    if command -v nvidia-smi >/dev/null; then
        timeout -k 1 5 nvidia-smi --query-gpu=name,memory.used,memory.total,utilization.gpu --format=csv || true
    fi
    printf '\n[VULKAN]\n'
    timeout -k 2 15 vulkaninfo --summary || true
    exit 0
fi
if [[ $action == registros ]]; then
    printf 'Ultimas lineas de lanzadores. No se exportan sesiones ni cuentas.\n'
    for name in steam steam-bibliotecas cyberpunk cyberpunk-heroic heroic gog-cyberpunk; do
        file=$HOME/.cache/ultra/$name.log
        if [[ -f $file ]]; then printf '\n[%s]\n' "$name"; tail -n 60 -- "$file"; fi
    done
    printf '\nPara Warframe: Steam > Propiedades > Opciones de lanzamiento: PROTON_LOG=1 %%command%%\nReproduce el fallo y consulta ~/steam-230410.log; desactiva luego esa opcion.\nLos registros pueden contener rutas personales; revisalos antes de compartir.\n'
    exit 0
fi
if ! mountpoint -q /juegos || [[ $HOME != /juegos/usuarios/ultra ]]; then
    notify-send --urgency=critical 'Juegos: falta almacenamiento' 'No se montó el almacenamiento Linux persistente. Consulta Estado y espacio.' || true
    exit 1
fi
available_kib=$(df -Pk -- /juegos | awk 'END {print $4}')
if [[ ! $available_kib =~ ^[0-9]+$ ]] || ((available_kib < 2097152)); then
    notify-send --urgency=critical 'Juegos: poco espacio' 'Quedan menos de 2 GiB. Las actualizaciones pueden fallar con errores de E/S. Revisa Estado y espacio.' || true
    [[ $action != warframe && $action != cyberpunk && $action != cyberpunk-directo ]] || exit 1
fi
mkdir -p "$HOME/.cache/ultra"
if [[ $action == steam || $action == warframe ]]; then
    registro_rc=0
    ultra-bibliotecas registrar-steam > "$HOME/.cache/ultra/steam-bibliotecas.log" 2>&1 || registro_rc=$?
    if (( registro_rc == 75 )); then
        notify-send 'Steam: revision en curso' 'Otra tarea esta registrando bibliotecas. Espera a que termine y vuelve a abrir; no se iniciara Steam durante esa escritura.' || true
        exit 75
    elif (( registro_rc != 0 )); then
        notify-send 'Steam: revisar bibliotecas' 'No se completo el registro automatico. Consulta Registros de juegos.' || true
    fi
fi
case $action in
    steam)
        ultra-espacio permitir-juegos || exit 1
        exec ultra-hud ejecutar steam >> "$HOME/.cache/ultra/steam.log" 2>&1;;
    warframe)
        ultra-espacio permitir-juegos || exit 1
        if ! ultra-bibliotecas buscar-steam 230410; then
            notify-send 'Warframe: biblioteca no encontrada' 'Selecciona su carpeta Steam desde Discos y carpetas; cierra Steam y vuelve a abrirlo.' || true
            exit 1
        fi
        exec ultra-hud ejecutar steam steam://rungameid/230410 >> "$HOME/.cache/ultra/steam.log" 2>&1;;
    gog)
        ultra-espacio permitir-juegos || exit 1
        if ! ultra-gog-cyberpunk > "$HOME/.cache/ultra/gog-cyberpunk.log" 2>&1; then
            notify-send 'GOG / Cyberpunk: revisar importacion' 'Consulta Registros de juegos. Si Heroic estaba abierto, cierralo y abre GOG otra vez.' || true
        fi
        exec ultra-hud ejecutar /opt/heroic/heroic --ozone-platform=wayland >> "$HOME/.cache/ultra/heroic.log" 2>&1;;
    cyberpunk)
        ultra-espacio permitir-juegos || exit 1
        if [[ ! -r /juegos/Cyberpunk2077/bin/x64/Cyberpunk2077.exe ]]; then
            notify-send --urgency=critical 'Cyberpunk: falta el montaje' 'El juego no esta accesible en /juegos/Cyberpunk2077. Revisa Estado y espacio; no hace falta instalarlo de nuevo.' || true
            exit 1
        fi
        # Open the manager first: the user can review updates before pressing Play.
        # The game's saved runner, prefix and launcher are managed by Heroic.
        if ! ultra-gog-cyberpunk > "$HOME/.cache/ultra/gog-cyberpunk.log" 2>&1; then
            notify-send 'Cyberpunk / Heroic' 'No se pudo registrar ahora. Se abre Heroic para revisar el juego; si estaba abierto, cierralo y vuelve a intentarlo.' || true
            exec ultra-hud ejecutar /opt/heroic/heroic --ozone-platform=wayland >> "$HOME/.cache/ultra/heroic.log" 2>&1
        fi
        notify-send 'Cyberpunk / GOG' 'Primero Heroic: selecciona Cyberpunk para actualizar o verificar. Pulsa Jugar para abrir REDlauncher.' || true
        exec ultra-hud ejecutar /opt/heroic/heroic --ozone-platform=wayland >> "$HOME/.cache/ultra/cyberpunk-heroic.log" 2>&1;;
    cyberpunk-directo)
        ultra-espacio permitir-juegos || exit 1
        game=/juegos/Cyberpunk2077/bin/x64/Cyberpunk2077.exe
        [[ -r $game ]] || { notify-send 'Cyberpunk no encontrado' 'No se encontro el ejecutable en /juegos/Cyberpunk2077.'; exit 1; }
        cd /juegos/Cyberpunk2077/bin/x64
        export WINEPREFIX="$HOME/Juegos/prefijos/cyberpunk2077" GAMEID=umu-0 PROTONPATH=GE-Proton
        export ULTRA_GAME_ID=ultra:cyberpunk2077 ULTRA_GAME_NAME='Cyberpunk 2077'
        export PROTON_LOG=1 PROTON_LOG_DIR="$HOME/.cache/ultra"
        notify-send 'Cyberpunk / recuperacion' 'Modo UMU separado de Heroic; guarda registro Proton en ~/.cache/ultra. La opcion normal usa tu configuracion de GOG.' || true
        result=0
        ultra-hud opengl umu-run "$game" --launcher-skip >> "$HOME/.cache/ultra/cyberpunk.log" 2>&1 || result=$?
        printf '\nULTRA: UMU termino con codigo %s\n' "$result" >> "$HOME/.cache/ultra/cyberpunk.log"
        (( result == 0 )) || notify-send --urgency=critical 'Cyberpunk: fallo de Proton' 'Consulta Juegos > Registros de juegos y el registro Proton en ~/.cache/ultra.' || true
        exit "$result";;
    *) exit 2;;
esac
