#!/usr/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
# Privileged mounts only. Never formats, repairs NTFS, forces hibernation or scans game files.
set -euo pipefail
[[ $(id -u) == 0 ]] || exit 1
uuid=''; image_uuid=''; image_bytes=''; image_path=ULTRA-juegos.ext4; game_uuid=''; partition_uuid=''
while IFS='=' read -r key value; do
    case $key in uuid) uuid=$value;; image_uuid) image_uuid=$value;; image_bytes) image_bytes=$value;; image_path) image_path=$value;; game_uuid) game_uuid=$value;; partition_uuid) partition_uuid=$value;; esac
done < /etc/ultra/juegos.conf
[[ $uuid =~ ^[0-9A-Fa-f]{16}$ && $image_uuid =~ ^[0-9a-f-]{36}$ && $image_bytes =~ ^[0-9]{8,12}$ ]] || exit 2
[[ $image_path == ULTRA-juegos.ext4 || $image_path == 'Espacio para Linux/ULTRA-juegos.ext4' ]] || exit 2
[[ -z $partition_uuid || $partition_uuid =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || exit 2
storage_uuid=${partition_uuid:-$image_uuid}
game_uuid=${game_uuid:-$uuid}
[[ $game_uuid =~ ^[0-9A-Fa-f]{16}$ ]] || exit 2
private=/run/ultra-juegos
volume=$private/volumen
if mountpoint -q /juegos; then
    [[ $(findmnt -n -o UUID --target /juegos) == "$storage_uuid" ]]
    exit $?
fi
install -d -m 0700 "$private" "$volume"
mounted_volume=0; mounted_data=0; success=0
rollback() {
    ((success)) && return
    ((mounted_data==0)) || umount /juegos || true
    ((mounted_volume==0)) || umount "$volume" || true
}
trap rollback EXIT
devices=()
if [[ -n $partition_uuid ]]; then
    found=$(blkid -t "UUID=$partition_uuid" -o device || true)
    [[ -z $found ]] || mapfile -t devices <<< "$found"
    (( ${#devices[@]} == 1 )) || { echo 'ROJO [JUEGOS]: particion Linux ausente o ambigua; no se abre una copia antigua'; exit 1; }
    device=${devices[0]}
    [[ -b $device && $(blkid -s TYPE -o value "$device") == ext4 ]] || exit 1
    install -d -m 0755 /juegos
    mount -t ext4 -o rw,nosuid,nodev "$device" /juegos
    mounted_data=1
else
found=$(blkid -t "UUID=${uuid^^}" -o device || true)
[[ -z $found ]] || mapfile -t devices <<< "$found"
(( ${#devices[@]} == 1 )) || { echo 'AMARILLO [JUEGOS]: volumen de almacenamiento ausente o ambiguo; no se monta otro'; exit 1; }
device=${devices[0]}
[[ -b $device && $(blkid -s TYPE -o value "$device") == ntfs ]] || exit 1
# root-only ancestor hides the entire Windows volume from desktop applications.
# File ownership below is usable through the game overlay without opening D: globally.
mount -t ntfs3 -o rw,nosuid,nodev,noexec,uid=1000,gid=1000,dmask=0022,fmask=0133,windows_names "$device" "$volume"
mounted_volume=1
image=$volume/$image_path
[[ $(realpath -e -- "$image" 2>/dev/null) == "$image" ]] || { echo 'ROJO [JUEGOS]: ruta ausente o redirigida'; exit 1; }
[[ -f $image && ! -L $image && $(stat -c %s "$image") == "$image_bytes" ]] || { echo 'ROJO [JUEGOS]: imagen de almacenamiento ausente o tamano distinto'; exit 1; }
[[ $(blkid -p -s TYPE -o value "$image") == ext4 && $(blkid -p -s UUID -o value "$image") == "$image_uuid" ]] || { echo 'ROJO [JUEGOS]: identidad ext4 distinta; no se formatea'; exit 1; }
install -d -m 0755 /juegos
mount -t ext4 -o loop,rw,nosuid,nodev "$image" /juegos
mounted_data=1
fi
install -d -m 0755 /juegos/usuarios
[[ ! -L /juegos/usuarios/ultra ]] || exit 1
install -d -m 0700 -o 1000 -g 1000 /juegos/usuarios/ultra
home=/juegos/usuarios/ultra
# Never follow user-controlled paths with root when seeding applications.
setpriv --reuid=1000 --regid=1000 --init-groups --no-new-privs \
    --inh-caps=-all --ambient-caps=-all --bounding-set=-all \
    /usr/bin/bash -c '
        set -e
        umask 077
        home=$1
        mkdir -p "$home/.config" "$home/.local/share" "$home/.local/state" "$home/.cache" "$home/Juegos/prefijos"
        cp -an /home/ultra/.config/. "$home/.config/"
    ' ultra-seed "$home"
native_game=/juegos/.ultra-cyberpunk-original/Cyberpunk2077
native_game_ready() {
    /usr/bin/python -I - "$storage_uuid" <<'PY'
import json,os,re,stat,sys
from pathlib import Path
parent=Path('/juegos/.ultra-cyberpunk-original');base=parent/'Cyberpunk2077'
def read(path,limit):
    if path.resolve()!=path:raise ValueError('enlace')
    fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
    with os.fdopen(fd,'rb') as f:
        if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):raise ValueError('archivo no regular')
        data=f.read(limit+1)
    if len(data)>limit:raise ValueError('archivo grande')
    return data
try:
    p=parent.stat()
    if parent.resolve()!=parent or p.st_uid!=0 or p.st_mode&0o077:raise ValueError('padre no privado')
    receipt=parent/'verificado.json';s=receipt.stat()
    if s.st_uid!=0 or s.st_mode&0o022:raise ValueError('recibo no protegido')
    data=json.loads(read(receipt,16384))
    if data.get('schema')!=1 or data.get('app')!='1423049311' or data.get('verified') is not True or data.get('storage_uuid')!=sys.argv[1]:raise ValueError('recibo distinto')
    if not re.fullmatch('[0-9a-f]{64}',str(data.get('sha256_manifest',''))):raise ValueError('sin huella')
    for directory in (base,base/'bin',base/'bin/x64'):
        s=directory.stat()
        if directory.resolve()!=directory or not stat.S_ISDIR(s.st_mode) or s.st_uid!=1000 or s.st_mode&0o022:raise ValueError('directorio no valido')
    exe=base/'bin/x64/Cyberpunk2077.exe'
    if exe.resolve()!=exe:raise ValueError('ejecutable redirigido')
    fd=os.open(exe,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
    with os.fdopen(fd,'rb') as f:
        if not stat.S_ISREG(os.fstat(f.fileno()).st_mode) or f.read(2)!=b'MZ':raise ValueError('PE invalido')
    info=json.loads(read(base/'goggame-1423049311.info',262144))
    if str(info.get('gameId'))!='1423049311' or str(info.get('rootGameId'))!='1423049311' or str(info.get('buildId'))!=data.get('build_id'):raise ValueError('producto distinto')
except (OSError,ValueError,TypeError,AttributeError):
    sys.exit(1)
PY
}
if native_game_ready; then
    game=$native_game
    echo 'VERDE [CYBERPUNK]: copia Linux verificada; no depende del disco Personal'
else
game_volume=$volume
if [[ -n $partition_uuid || ${game_uuid^^} != ${uuid^^} ]]; then
    game_devices=()
    found=$(blkid -t "UUID=${game_uuid^^}" -o device || true)
    [[ -z $found ]] || mapfile -t game_devices <<< "$found"
    game_volume=$private/originales
    if (( ${#game_devices[@]} == 1 )) && [[ -b ${game_devices[0]} && $(blkid -s TYPE -o value "${game_devices[0]}") == ntfs ]]; then
        install -d -m 0700 "$game_volume"
        # Optional original game volume: never force a dirty/hibernated NTFS.
        mount -t ntfs3 -o ro,nosuid,nodev,noexec,uid=1000,gid=1000,dmask=0022,fmask=0133 "${game_devices[0]}" "$game_volume" || true
    fi
fi
game="$game_volume/Cyberpunk 2077"
fi
if [[ -f $game/bin/x64/Cyberpunk2077.exe && ! -L $game ]]; then
    install -d -m 0755 /juegos/Cyberpunk2077 /juegos/overlay
    install -d -m 0755 -o 1000 -g 1000 /juegos/overlay/upper /juegos/overlay/work
    # Writes go to ext4 upper; the installed GOG game on D: remains the lower layer.
    mount -t overlay overlay -o "nosuid,nodev,lowerdir=$game,upperdir=/juegos/overlay/upper,workdir=/juegos/overlay/work" /juegos/Cyberpunk2077
fi
success=1
echo 'VERDE [JUEGOS]: almacenamiento ext4 persistente y home preparados; volumen privado; juego con capa de escritura separada'
