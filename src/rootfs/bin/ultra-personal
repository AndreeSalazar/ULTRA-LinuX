#!/usr/bin/python3
# SPDX-License-Identifier: GPL-2.0-only
"""Disco Personal (D: de Windows, exFAT "PERSONAL") para archivos y respaldos.

    ultra-personal montar | desmontar       lo usa ultra-sesion (root)
    ultra-personal estado

D: se formateo desde Windows como exFAT con etiqueta PERSONAL (2026-11-02):
Windows y ULTRA leen y escriben lo mismo, sin limite de 4 GB por archivo.
Solo se monta un volumen interno (no USB) con esa etiqueta y sistema exFAT
(o ext4 ULTRA-PERSONAL si algun dia se elige Linux puro). Nunca formatea.
"""
import json
import os
from pathlib import Path
import subprocess
import sys

TARGET = Path('/personal')
USER_DIR = TARGET/'ultra'
VOLUMES = {('exfat', 'PERSONAL'), ('ext4', 'ULTRA-PERSONAL')}
# exFAT has no owners: the mount gives every file to the desktop user, privately.
EXFAT_OPTIONS = 'rw,nosuid,nodev,noexec,noatime,uid=1000,gid=1000,dmask=0077,fmask=0177,iocharset=utf8'
EXT4_OPTIONS = 'rw,nosuid,nodev,noatime'


def run(*args, **kwargs):
    return subprocess.run(args, check=True, text=True, capture_output=True, timeout=120, **kwargs).stdout


def blocks():
    doc = json.loads(run('/usr/bin/lsblk', '-J', '-b', '-p', '-o', 'NAME,TYPE,SIZE,FSTYPE,UUID,LABEL,TRAN,MOUNTPOINTS'))
    rows = []
    def visit(nodes, tran=None):
        for node in nodes:
            node['tran'] = node.get('tran') or tran
            rows.append(node)
            visit(node.get('children', []), node['tran'])
    visit(doc['blockdevices'])
    return rows


def mounted(node):
    return any(m for m in node.get('mountpoints') or [] if m)


def find_personal(rows):
    found = [r for r in rows if r.get('type') == 'part' and (r.get('fstype'), r.get('label')) in VOLUMES
             and r.get('tran') != 'usb']
    if len(found) > 1: raise ValueError('hay mas de un disco Personal; no se monta ninguno')
    return found[0] if found else None


def mount_personal():
    part = find_personal(blocks())
    if not part: print('AMARILLO [PERSONAL]: sin disco PERSONAL (exFAT) interno'); return 0
    if os.path.ismount(TARGET):
        print('VERDE [PERSONAL]: /personal ya montado'); return 0
    if mounted(part): raise ValueError('el disco Personal ya esta montado en otra ruta')
    TARGET.mkdir(mode=0o755, exist_ok=True)
    if TARGET.is_symlink(): raise ValueError('/personal es un enlace; no se monta')
    exfat = part['fstype'] == 'exfat'
    run('/usr/bin/mount', '-t', part['fstype'], '-o', EXFAT_OPTIONS if exfat else EXT4_OPTIONS, part['name'], str(TARGET))
    if USER_DIR.is_symlink(): raise ValueError('/personal/ultra es un enlace')
    USER_DIR.mkdir(mode=0o700, exist_ok=True)
    if not exfat:
        os.chown(USER_DIR, 1000, 1000); os.chmod(USER_DIR, 0o700)
    free = os.statvfs(TARGET); gb = free.f_bavail*free.f_frsize/10**9
    print(f'VERDE [PERSONAL]: {part["name"]} ({part["fstype"]}) en /personal; libres {gb:.0f} GB')
    return 0


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else 'estado'
    if action == 'estado':
        part = find_personal(blocks())
        print(json.dumps({'disco': part['name'] if part else None, 'sistema': part['fstype'] if part else None,
                          'montado': os.path.ismount(TARGET)}))
        return 0
    if os.geteuid() != 0: raise ValueError('montar y desmontar requieren root (ultra-sesion)')
    if action == 'montar': return mount_personal()
    if action == 'desmontar':
        if os.path.ismount(TARGET): os.sync(); run('/usr/bin/umount', str(TARGET))
        return 0
    raise ValueError('Uso: ultra-personal montar|desmontar|estado')


if __name__ == '__main__':
    try: sys.exit(main())
    except (OSError, ValueError, subprocess.SubprocessError, KeyError) as error:
        print('ROJO [PERSONAL]:', error, file=sys.stderr); sys.exit(1)
